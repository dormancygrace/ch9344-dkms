#!/bin/sh
set -e

module=ch9344
version=2.3.1

# Older packages could leave stale DKMS records during an upgrade. Remove the
# two known predecessor versions before asking DKMS to enumerate kernels.
for stale_version in 2.2.0 2.3.0; do
    if [ -e "/var/lib/dkms/ch9344/$stale_version" ]; then
        dkms remove -m "$module" -v "$stale_version" --all 2>/dev/null || true
        rm -rf "/var/lib/dkms/ch9344/$stale_version"
    fi
done

if dkms status -m "$module" -v "$version" 2>/dev/null | grep -q .; then
    dkms remove -m "$module" -v "$version" --all || true
fi

dkms add -m "$module" -v "$version"

# Build for every installed kernel that has headers available. This covers the
# running Proxmox kernel as well as a newly installed kernel awaiting reboot.
for kernel_dir in /lib/modules/*; do
    [ -f "$kernel_dir/build/Makefile" ] || continue
    kernel_version=${kernel_dir##*/}
    dkms autoinstall -k "$kernel_version" -m "$module" -v "$version"
done

depmod -a
modprobe "$module" || true

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=tty || true
fi

exit 0
